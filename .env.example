# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:ABC-your-token

# Максимальный размер файла в МБ. Обычный Bot API позволяет отправлять до 50 МБ.
# С локальным Bot API сервером можно поднять до 2000.
MAX_FILE_MB=50

# Адрес локального Bot API сервера (необязательно), например http://localhost:8081
TELEGRAM_API_URL=

# Для локального Bot API сервера (docker compose --profile big-files):
# получить на https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Самое высокое качество, которое бот предложит на выбор
MAX_HEIGHT=1080

# Сколько загрузок выполнять одновременно
MAX_CONCURRENT_DOWNLOADS=3

# Путь к cookies.txt в формате Netscape (нужен для части видео из Instagram/TikTok/VK)
COOKIES_FILE=

# Прокси для yt-dlp (необязательно), например socks5://127.0.0.1:1080
YTDLP_PROXY=
